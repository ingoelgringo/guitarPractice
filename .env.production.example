# Mall för Ägarens konto och sessionen. På servern ligger den ifyllda filen i
# /home/deploy/guitar-practice/.env (utanför releaserna) och läses av
# deploy/ecosystem.config.cjs. Lokalt kan samma rader stå i .env.local.

OWNER_USERNAME=
# bcrypt-hash från `npm run hash-password`. Står den i .env.local måste varje $
# skrivas \$, eftersom Next.js expanderar variabler där. I serverns fil skrivs den som den är.
# Ett nytt lösenord loggar inte ut befintliga sessioner. Byt även SESSION_SECRET om det behövs.
OWNER_PASSWORD_HASH=
# Bibliotekets databas. Lokalt: postgres://guitarpractice:guitarpractice@localhost:5433/guitarpractice
# (docker compose up -d, sedan npm run migrate). På servern ligger den i containern
# folkbibeln-postgres: postgres://guitarpractice:<lösenord>@127.0.0.1:5435/guitarpractice
# Deployen kör migreringarna med den här adressen före omstarten.
DATABASE_URL=
# Minst 32 slumpade tecken, t.ex. `openssl rand -base64 48`. Byts den loggas Ägaren ut.
SESSION_SECRET=
